# Postgres (used by the postgres container and DATABASE_URL below)
POSTGRES_USER=vantage
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vantage

# Backend (postgres/parser hostnames resolve over the docker-compose network;
# from the host machine, postgres is also reachable at localhost:5433)
DATABASE_URL=postgres://vantage:change-me@postgres:5432/vantage
SESSION_SECRET=change-me-to-a-long-random-string
PORT=3001
PARSER_URL=http://parser:8000
